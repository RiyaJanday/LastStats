# Copy this file to .env (or export these as real environment variables
# in your shell / IDE run config) before starting market-data-service.
# Never commit the real values.

# Free-tier key from https://twelvedata.com/ — used for non-Indian
# stock quotes in market-data-service. Indices and Indian stocks fall
# back to Yahoo Finance's unofficial endpoint and don't need this key,
# but individual non-Indian stock lookups do.
TWELVEDATA_API_KEY=
